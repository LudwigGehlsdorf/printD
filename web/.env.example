# --- Authentication (Authentik OIDC) -----------------------------------------
# Generate with: npx auth secret   (or: openssl rand -base64 33)
AUTH_SECRET=
# Defaults: D-sektionen's public dev client (same as in github.com/Dsek-LTH/web).
# It has no secret and only redirects to localhost. Production needs its own client.
AUTH_AUTHENTIK_ID=SvRybUTCGqhNiw2Y3gn1wqt0YxpjW2sv9fbPsUaP
AUTH_AUTHENTIK_SECRET=
# The provider's "OpenID Configuration Issuer"
AUTH_AUTHENTIK_ISSUER=https://auth.dsek.se/application/o/dev/
# Required when running behind a reverse proxy or outside Vercel.
AUTH_TRUST_HOST=true
# Comma-separated Authentik groups that may print. Subgroups count too:
# "dsek.infu" allows members of "dsek.infu.mdlm".
# Leave empty to let anyone with an account on the Authentik server print.
PRINT_ALLOWED_GROUPS=

# --- Printing ----------------------------------------------------------------
# "dry-run" saves PDFs to DATA_DIR/dry-run instead of printing. "cups" prints.
PRINT_MODE=dry-run
# CUPS queue name (see `lpstat -p`).
PRINTER_NAME=Canon_MF744Cdw
# "ufr2" = Canon's UFR II driver (needed for Secure Print), "ipp" = driverless queue.
PRINTER_DRIVER=ufr2
# Hold jobs on the printer until the user enters a PIN on its screen (Canon Secure Print).
SECURE_PRINT=true
# 4-7 digits
SECURE_PRINT_PIN_LENGTH=4
# How long a held job is shown as "waiting at the printer" (match the printer's setting).
SECURE_PRINT_HOLD_HOURS=4
# How Canon's driver wants the PIN: base64 or plain. The default matches the driver build
# for the current platform; switch it if held jobs reject their PIN.
# SECURE_PRINT_PIN_ENCODING=
MAX_UPLOAD_MB=50
MAX_COPIES=50
UPLOAD_TTL_MINUTES=60
DATA_DIR=./data
# Optional: path to LibreOffice's soffice binary, if it is not found automatically.
# SOFFICE_PATH=

# --- Development only ----------------------------------------------------------
# Skip Authentik and log in as a fake user. Ignored in production builds.
# DEV_FAKE_USER=1
