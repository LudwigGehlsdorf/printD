# printD production settings. setup-pi.sh copies this to /etc/printd/printd.env
# (readable by root and the printd user only) and fills in AUTH_SECRET.
# After editing: sudo systemctl restart printd

# --- Authentication (Authentik OIDC) -----------------------------------------
# Generated by setup-pi.sh. Changing it logs everyone out.
AUTH_SECRET=
# From the production Authentik provider. Its redirect URI must be
# https://<host>/api/auth/callback/authentik
AUTH_AUTHENTIK_ID=
AUTH_AUTHENTIK_SECRET=
# The provider's "OpenID Configuration Issuer", e.g. https://auth.dsek.se/application/o/printd/
AUTH_AUTHENTIK_ISSUER=
# The app runs behind Caddy, which sets the forwarded host and protocol.
AUTH_TRUST_HOST=true
# Comma-separated Authentik groups that may print (subgroups count too).
# Empty: every account on the Authentik server may print.
PRINT_ALLOWED_GROUPS=

# --- Printing ----------------------------------------------------------------
PRINT_MODE=cups
# The CUPS queue created by setup-pi.sh.
PRINTER_NAME=printd
PRINTER_DRIVER=ufr2
SECURE_PRINT=true
SECURE_PRINT_PIN_LENGTH=4
# Match the printer's own Secure Print deletion time.
SECURE_PRINT_HOLD_HOURS=4
# Canon's Linux driver expects the PIN base64 encoded (the default on Linux). If held jobs
# appear on the printer but the PIN is rejected, try: SECURE_PRINT_PIN_ENCODING=plain
# SECURE_PRINT_PIN_ENCODING=base64

# --- Limits and storage --------------------------------------------------------
MAX_UPLOAD_MB=50
MAX_COPIES=50
UPLOAD_TTL_MINUTES=60
DATA_DIR=/var/lib/printd
