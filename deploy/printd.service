[Unit]
Description=printD web app
After=network-online.target cups.service
Wants=network-online.target

[Service]
Type=simple
User=printd
Group=printd
WorkingDirectory=/opt/printd
EnvironmentFile=/etc/printd/printd.env
Environment=HOME=/var/lib/printd
Environment=NODE_ENV=production
# Serves HTTPS on all interfaces with the self-signed certificate made by setup.sh.
Environment=PORT=8443
Environment=TLS_CERT=/etc/printd/tls/cert.pem
Environment=TLS_KEY=/etc/printd/tls/key.pem
ExecStart=/usr/bin/node deploy/server.mjs
Restart=on-failure
RestartSec=5

# Hardening. The app only writes its data directory and talks to CUPS over its socket.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/printd /run/cups
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
