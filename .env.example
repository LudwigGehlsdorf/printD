# printD settings. The values below are for development: copy this file to .env.local.
# In production, deploy/setup.sh creates /etc/printd/printd.env from it, with the production
# values filled in (marked "Production:" below). Restart printD after changing it:
#   sudo systemctl restart printd

# --- Authentication (Authentik OIDC) -----------------------------------------
# Random secret for login sessions. Changing it logs everyone out.
# Generate with: openssl rand -base64 33   Production: generated.
AUTH_SECRET=
# The address users open printD at. Login redirects are built from it, so it must match the
# browser's address bar. Not needed in development.
# Production: https://<host>:<PORT>
# AUTH_URL=
# Builds login redirects from the request instead of AUTH_URL; needed for `pnpm start`.
AUTH_TRUST_HOST=true
# Defaults: D-sektionen's public dev client (same as in github.com/Dsek-LTH/web). It has no
# secret and only redirects to localhost. Production: empty, fill in your own provider; its
# redirect URI must be <AUTH_URL>/api/auth/callback/authentik
AUTH_AUTHENTIK_ID=SvRybUTCGqhNiw2Y3gn1wqt0YxpjW2sv9fbPsUaP
AUTH_AUTHENTIK_SECRET=
# The provider's "OpenID Configuration Issuer", e.g. https://auth.dsek.se/application/o/printd/
AUTH_AUTHENTIK_ISSUER=https://auth.dsek.se/application/o/dev/
# Comma-separated Authentik groups that may print. Subgroups count too:
# "dsek.infu" allows members of "dsek.infu.mdlm".
# Leave empty to let anyone with an account on the Authentik server print.
PRINT_ALLOWED_GROUPS=

# --- Printing ----------------------------------------------------------------
# "dry-run" saves PDFs to DATA_DIR/dry-run instead of printing. "cups" prints.
# Production: cups
PRINT_MODE=dry-run
# CUPS queue name (see `lpstat -p`). Production: printd, the queue setup.sh creates.
PRINTER_NAME=Canon_MF744Cdw
# "ufr2" = Canon's UFR II driver (needed for Secure Print), "ipp" = driverless queue.
PRINTER_DRIVER=ufr2
# Hold jobs on the printer until the user enters a PIN on its screen (Canon Secure Print).
SECURE_PRINT=true
# 4-7 digits
SECURE_PRINT_PIN_LENGTH=4
# How long a held job is shown as "waiting at the printer" (match the printer's setting).
SECURE_PRINT_HOLD_HOURS=4

# --- Limits and storage --------------------------------------------------------
MAX_UPLOAD_MB=50
MAX_COPIES=50
UPLOAD_TTL_MINUTES=60
# Uploads, the print log (print.db) and dry-run output. Production: /var/lib/printd
DATA_DIR=./data
# Optional: path to LibreOffice's soffice binary, if it is not found automatically.
# SOFFICE_PATH=

# --- Production server ---------------------------------------------------------
# HTTPS port of deploy/server.mjs. Production: set by setup.sh.
# PORT=8443

# --- Development only ----------------------------------------------------------
# Skip Authentik and log in as a fake user. Ignored in production builds.
# DEV_FAKE_USER=1
